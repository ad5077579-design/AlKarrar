# USD-M Futures API keys (Binance API Management).
#
# --- ورق / ديمو (افتراضي) — منصة Binance الموحّدة للديمو ---
# أنشئ المفاتيح من https://demo.binance.com ثم اربطها هنا.
# عند BINANCE_TESTNET=true يستخدم التطبيق **demo-fapi.binance.com** (وليس testnet.binance.vision).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ضع true فقط إذا كانت مفاتيحك من **تست نت Futures القديم** https://testnet.binancefuture.com
# (وليست من demo.binance.com).
BINANCE_LEGACY_FUTURES_TESTNET=false

# Public mark price stream → WebSocket dashboard.
ALKARRAR_MARK_FEED=true

# REST poll: wallet / margin / available / unrealized + position reconcile → hub + WS.
ALKARRAR_ACCOUNT_SYNC=true
ALKARRAR_ACCOUNT_SYNC_INTERVAL=4

# Authenticated user data stream (listenKey) → instant balance push + debounced full REST resync.
ALKARRAR_USER_STREAM=true

# --- Nuxt frontend (optional) ---
# If the dashboard shows "WS: offline", point the browser WebSocket straight at FastAPI (default API port 8090):
# NUXT_PUBLIC_WS_URL=ws://127.0.0.1:8090/ws
