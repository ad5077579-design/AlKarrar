# =============================================================================
# AlKarrar Pro — Environment configuration (copy to .env, never commit .env)
# =============================================================================
# Documentation: README.md | Full list: AGENTS.md
# Verify keys:  python scripts/probe_binance_env.py --no-cache
#               python scripts/test_binance_spot_keys.py
# =============================================================================

# -----------------------------------------------------------------------------
# Binance Spot API credentials
# -----------------------------------------------------------------------------
# Create keys from ONE host only (see table). Wrong host → error -2015.
#
# | BINANCE_ENV hint | Create keys at                          |
# |------------------|-----------------------------------------|
# | demo             | https://demo.binance.com                |
# | testnet          | https://testnet.binance.vision           |
# | mainnet          | https://www.binance.com → API Management  |
#
BINANCE_ENV=demo
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Legacy fallback when BINANCE_ENV is empty: true → testnet, false → mainnet
BINANCE_TESTNET=true

# Ignored (Spot-only project; kept for old .env files)
BINANCE_LEGACY_FUTURES_TESTNET=false

# -----------------------------------------------------------------------------
# Environment auto-detection (recommended: true)
# -----------------------------------------------------------------------------
# Probes demo → mainnet → testnet via signed REST; BINANCE_ENV is hint only.
ALKARRAR_AUTO_DETECT_BINANCE_ENV=true

# -----------------------------------------------------------------------------
# Live feeds & account sync
# -----------------------------------------------------------------------------
ALKARRAR_MARK_FEED=true
ALKARRAR_ACCOUNT_SYNC=true
ALKARRAR_ACCOUNT_SYNC_INTERVAL=2
ALKARRAR_USER_STREAM=true

# -----------------------------------------------------------------------------
# Grid execution (virtual lines → LIMIT IOC by default)
# -----------------------------------------------------------------------------
ALKARRAR_GRID_EXEC_ORDER_TYPE=LIMIT_IOC
ALKARRAR_GRID_EXEC_MIN_INTERVAL_S=0.25
ALKARRAR_GRID_MAX_SLIPPAGE_PCT=0.008
ALKARRAR_GRID_EXEC_BURST=12

# Bootstrap MARKET buy for sell inventory (0=off, recommended)
ALKARRAR_GRID_BOOTSTRAP_MARKET=0
ALKARRAR_GRID_BOOTSTRAP_MAX_DEPLOY_FRAC=0.35
ALKARRAR_SPOT_TAKER_FEE_RATIO=0.001

# -----------------------------------------------------------------------------
# Risk & compounding
# -----------------------------------------------------------------------------
# Trailing equity stop: flatten when grid equity drops this fraction from peak
ALKARRAR_TRAILING_EQUITY_DRAWDOWN_PCT=0.10
# Min realized profit (fraction of deploy) before compound lot resize
ALKARRAR_COMPOUND_RESIZE_PCT=0.01

# -----------------------------------------------------------------------------
# Stability: crash recovery & database retention
# -----------------------------------------------------------------------------
# Resume grids from SQLite snapshot after API restart (manual stop disables)
ALKARRAR_GRID_AUTO_RESUME=true
# Background purge inside API (no external cron)
ALKARRAR_MAINTENANCE_ENABLED=true
ALKARRAR_MAINTENANCE_INTERVAL_HOURS=24
ALKARRAR_AUDIT_RETENTION_DAYS=7
ALKARRAR_TRADE_FILL_RETENTION_DAYS=30
# RAM: filled orderId dedupe window (ms), default 48h
ALKARRAR_FILLED_OID_RETENTION_MS=172800000

# -----------------------------------------------------------------------------
# Nuxt frontend (production / custom deploy)
# -----------------------------------------------------------------------------
# Leave empty in dev — Nuxt proxies /api and /ws to 127.0.0.1:8090
# NUXT_PUBLIC_API_BASE=
# NUXT_PUBLIC_WS_URL=ws://127.0.0.1:8090/ws

# Optional: force uvicorn --reload when using scripts/run_api.ps1
# ALKARRAR_UVICORN_RELOAD=1
