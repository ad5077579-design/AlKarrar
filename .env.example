# Binance Spot API keys (Binance API Management).

#

# --- بيئة Spot (اختر واحدة عبر BINANCE_ENV) ---

# demo    → مفاتيح من https://demo.binance.com (Spot Demo Trading)

# testnet → مفاتيح من https://testnet.binance.vision

# mainnet → مفاتيح الإنتاج من binance.com

BINANCE_ENV=demo

BINANCE_API_KEY=

BINANCE_API_SECRET=

# عند غياب BINANCE_ENV: true → testnet، false → mainnet

BINANCE_TESTNET=true



# Ignored (kept for backward compatibility with older .env files).

BINANCE_LEGACY_FUTURES_TESTNET=false



# Public mark price stream → WebSocket dashboard.

ALKARRAR_MARK_FEED=true



# REST poll: wallet / available → hub + WS.

ALKARRAR_ACCOUNT_SYNC=true

ALKARRAR_ACCOUNT_SYNC_INTERVAL=2



# Authenticated user data stream (listenKey) → instant balance push + debounced full REST resync.

ALKARRAR_USER_STREAM=true

# Virtual grid (default): no pre-placed LIMIT — lines in RAM/DB; fire MARKET or LIMIT+IOC on mark cross.

# ALKARRAR_GRID_EXEC_ORDER_TYPE=LIMIT_IOC
# ALKARRAR_GRID_EXEC_MIN_INTERVAL_S=0.25
# ALKARRAR_GRID_MAX_SLIPPAGE_PCT=0.008
# ALKARRAR_GRID_EXEC_BURST=12



# --- Nuxt frontend (optional) ---

# If the dashboard shows "WS: offline", point the browser WebSocket straight at FastAPI (default API port 8090):

# NUXT_PUBLIC_WS_URL=ws://127.0.0.1:8090/ws

